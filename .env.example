# Copiez ce fichier en `.env` et adaptez les valeurs.

# Clé secrète des sessions Flask (obligatoire en production).
# Générez-en une avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-production

# Environnement d'exécution : development | production
FLASK_CONFIG=development

# Base de données.
# - En développement, laissez vide : SQLite est utilisé automatiquement.
# - En production (Render), définissez l'URL PostgreSQL fournie par l'hébergeur, ex. :
# DATABASE_URL=postgresql://user:password@host:5432/nom_base
DATABASE_URL=
